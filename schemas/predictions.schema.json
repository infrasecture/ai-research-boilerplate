{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["predictions", "unanswered", "notes"],
  "properties": {
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "answer"],
        "properties": {
          "sample_id": {"type": "string"},
          "answer": {"type": "number"}
        }
      }
    },
    "unanswered": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
